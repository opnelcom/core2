      "type": "grid",
      "title": "Parties",
      "uiWidth": "full",
      "rowSchema": {
        "type": "object",
        "properties": {
          "party": {
            "type": "reference",
            "title": "Party",
            "target": {
              "class": "legal_entity"
            },
            "uiWidth": "medium",
            "sortOrder": 10
          },
          "role": {
            "type": "select",
            "title": "Role",
            "options": [
              {
                "code": "customer",
                "description": "Customer"
              },
              {
                "code": "supplier",
                "description": "Supplier"
              },
              {
                "code": "landlord",
                "description": "Landlord"
              },
              {
                "code": "tenant",
                "description": "Tenant"
              },
              {
                "code": "guarantor",
                "description": "Guarantor"
              },
              {
                "code": "other",
                "description": "Other"
              }
            ],
            "uiWidth": "medium",
            "sortOrder": 20
          },
          "notes": {
            "type": "long_text",
            "title": "Notes",
            "maxLength": 4000,
            "rows": 3,
            "uiWidth": "full",
            "sortOrder": 30
          }
        },
        "required": [
          "party",
          "role"
        ],
        "additionalProperties": false
      },
      "sortOrder": 110

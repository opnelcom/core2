          "code": "lease_in",
          "description": "Lease in"
        },
        {
          "code": "lease_out",
          "description": "Lease out"
        },
        {
          "code": "service_provision",
          "description": "Service provision"
        },
        {
          "code": "service_contract",
          "description": "Service contract"
        },
        {
          "code": "supply_contract",
          "description": "Supply contract"
        },
        {
          "code": "grant_agreement",
          "description": "Grant agreement"
        },
        {
          "code": "maintenance_contract",
          "description": "Maintenance contract"
        },
        {
          "code": "rental_agreement",
          "description": "Rental agreement"
        },
        {
          "code": "other",
          "description": "Other"
        }

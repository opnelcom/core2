      "uiWidth": "full",
      "rowSchema": {
        "type": "object",
        "properties": {
          "milestone": {
            "type": "text",
            "title": "Milestone",
            "maxLength": 150,
            "uiWidth": "medium",
            "sortOrder": 10
          },
          "targetDate": {
            "type": "date",
            "title": "Target date",
            "uiWidth": "short",
            "sortOrder": 20

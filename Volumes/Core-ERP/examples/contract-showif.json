          "status": {
            "type": "select",
            "title": "Status",
            "options": [
              {
                "code": "planned",
                "description": "Planned"
              },
              {
                "code": "in_progress",
                "description": "In progress"
              },
              {
                "code": "complete",
                "description": "Complete"
              }
            ],
            "uiWidth": "medium",
            "sortOrder": 30
          },
          "notes": {
            "type": "long_text",
            "title": "Notes",
            "maxLength": 4000,
            "rows": 3,
            "uiWidth": "full",
            "sortOrder": 40
          }
        },
        "required": [
          "milestone",
          "targetDate"
        ],
        "additionalProperties": false
      },
      "sortOrder": 120
    }

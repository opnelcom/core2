          "lease_in",
          "lease_out",
          "maintenance_contract",
          "rental_agreement"
        ]
      }
    },
    "contractValue": {
      "type": "currency",
      "title": "Contract Value",
      "uiWidth": "medium",
      "precision": 14,
      "scale": 2,
      "minimum": 0,
      "sortOrder": 70
    },
    "currencyCode": {
      "type": "short_text",
      "title": "Currency Code",
      "uiWidth": "short",
      "maxLength": 3,
      "pattern": "[A-Z]{3}",
      "placeholder": "ZAR",
      "sortOrder": 80
    },
    "responsiblePerson": {
      "type": "text",
      "title": "Responsible Person",
      "x-searchable": true,
      "uiWidth": "medium",
      "maxLength": 150,
      "sortOrder": 90
    },
    "fixedCharges": {
      "type": "grid",
      "title": "Fixed charges",
      "uiWidth": "full",
      "rowSchema": {
        "type": "object",
        "properties": {
          "chargeComponent": {
            "type": "reference",
            "title": "Charge component",
            "target": {
              "class": "accounting_dimension",
              "types": [
                "charge_component"
              ]
            },
            "uiWidth": "medium",
            "sortOrder": 10
          },
          "effectiveFrom": {
            "type": "date",
            "title": "Effective from",
            "uiWidth": "short",
            "sortOrder": 20
          },
          "effectiveTo": {
            "type": "date",
            "title": "Effective to",
            "uiWidth": "short",
            "sortOrder": 30,
            "showif": {
              "scope": "row",
              "field": "frequency",
              "operator": "ne",
              "value": "once"
            }
          },
          "amount": {
            "type": "currency",
            "title": "Amount",
            "precision": 14,
            "scale": 2,
            "minimum": 0,
            "uiWidth": "medium",
            "sortOrder": 40
          },
          "currencyCode": {
            "type": "short_text",
            "title": "Currency",
            "maxLength": 3,
            "uiWidth": "short",
            "pattern": "[A-Z]{3}",
            "placeholder": "ZAR",
            "sortOrder": 50
          },
          "frequency": {
            "type": "select",
            "title": "Frequency",
            "options": [
              {
                "code": "once",
                "description": "Once"
              },
              {
                "code": "monthly",
                "description": "Monthly"
              },
              {
                "code": "quarterly",
                "description": "Quarterly"
              },
              {
                "code": "annually",
                "description": "Annually"
              }
            ],
            "uiWidth": "medium",
            "sortOrder": 60
          }
        },
        "required": [
          "chargeComponent",
          "effectiveFrom",
          "amount",
          "currencyCode",
          "frequency"
        ],
        "additionalProperties": false
      },
      "periodControl": {
        "from": "effectiveFrom",
        "to": "effectiveTo",
        "groupBy": [
          "chargeComponent"
        ],
        "allowOverlap": false
      },
      "helpText": "Reference charges only; no automatic billing or postings.",
      "sortOrder": 100,
      "showif": {
        "field": "contractType",
        "operator": "in",
        "value": [
          "lease_in",
          "lease_out",
          "rental_agreement"
        ]
      }
    },
